// =============================================================================
// Dir Food - Prisma schema
// PostgreSQL | multi-tenant (shared database, restaurant_id on every business table)
//
// Conventions
//  - IDs: UUID v7 (time-ordered)
//  - DB columns snake_case, Prisma fields camelCase (@map / @@map)
//  - Nothing is cascade-deleted except line items owned entirely by parent intents
//  - Prices and amounts: BigInt in PAISA (PKR 100 = 10000)
//  - Multi-tenant security: every business table is scoped by restaurant_id
//
// This schema is MULTI-FILE. Prisma merges every `.prisma` file under `prisma/`
// into one logical schema; `prisma.config.ts` points `schema` at this folder.
//   - enums.prisma            all enums
//   - models/tenant.prisma    Restaurant, User
//   - models/delivery.prisma  Area, RestaurantDeliveryArea, RestaurantHours
//   - models/menu.prisma      MenuCategory, MenuItem, MenuItemVariant
//   - models/orders.prisma    OrderIntent, OrderIntentItem
//   - models/audit.prisma     AuditLog
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

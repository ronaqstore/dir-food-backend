// =============================================================================
// MENU CATALOG: CATEGORIES, ITEMS, AND VARIANTS
// =============================================================================

model MenuCategory {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      MenuItem[]

  @@unique([id, restaurantId]) // target of the composite FK from menu_items
  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  basePrice    BigInt?  @map("base_price") // null when variants are used
  isAvailable  Boolean  @default(true) @map("is_available")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category    MenuCategory      @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  variants    MenuItemVariant[]
  intentItems OrderIntentItem[]

  @@unique([id, restaurantId]) // target of composite FKs from variants and order_intent_items
  @@index([restaurantId, categoryId, sortOrder])
  @@map("menu_items")
}

model MenuItemVariant {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  name         String
  price        BigInt
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  menuItem    MenuItem          @relation(fields: [menuItemId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  intentItems OrderIntentItem[]

  @@unique([id, restaurantId, menuItemId]) // target of the composite FK from order_intent_items
  @@index([menuItemId])
  @@map("menu_item_variants")
}


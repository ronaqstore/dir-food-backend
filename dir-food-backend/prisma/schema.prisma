generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ManualStatus {
  AUTO
  CLOSED
  TEMP_UNAVAILABLE
}

enum UserRole {
  RESTAURANT_OWNER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrderIntentStatus {
  WHATSAPP_HANDOFF_READY
  WHATSAPP_OPENED
}

enum DeliveryFeeStatus {
  KNOWN
  TO_BE_CONFIRMED
}

model Restaurant {
  id                 String           @id @default(uuid(7)) @db.Uuid
  name               String
  slug               String           @unique
  description        String?
  cuisines           String[]         @default([])
  logoUrl            String?          @map("logo_url")
  coverUrl           String?          @map("cover_url")
  addressText        String?          @map("address_text")
  contactPhone       String?          @map("contact_phone")
  whatsappNumber     String?          @map("whatsapp_number")
  minOrderAmount     BigInt?          @map("min_order_amount")
  status             RestaurantStatus @default(PENDING)
  statusReason       String?          @map("status_reason")
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(3)
  // Subscription (separate from status). Both NULL until first approval.
  trialStartedAt     DateTime?        @map("trial_started_at") @db.Timestamptz(3)
  subscriptionEndsAt DateTime?        @map("subscription_ends_at") @db.Timestamptz(3)
  manualStatus       ManualStatus     @default(AUTO) @map("manual_status")
  unavailableNote    String?          @map("unavailable_note")
  adminNotes         String?          @map("admin_notes")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  hours            RestaurantHours[]
  deliveryAreas    RestaurantDeliveryArea[]
  categories       MenuCategory[]
  items            MenuItem[]
  variants         MenuItemVariant[]
  orderIntents     OrderIntent[]
  orderIntentItems OrderIntentItem[]
  auditLogs        AuditLog[]

  @@index([status, subscriptionEndsAt])
  @@map("restaurants")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  restaurantId     String?    @map("restaurant_id") @db.Uuid
  name             String
  phone            String     @unique
  passwordHash     String?    @map("password_hash")
  setupTokenHash   String?    @map("setup_token_hash")
  setupExpiresAt   DateTime?  @map("setup_expires_at") @db.Timestamptz(3)
  role             UserRole
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  auditLogs  AuditLog[]

  @@index([restaurantId])
  @@map("users")
}

// Shared master list. One row can be used by many restaurants via RestaurantDeliveryArea.
model Area {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurantAreas RestaurantDeliveryArea[]

  @@map("areas")
}

model RestaurantDeliveryArea {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  areaId       String   @map("area_id") @db.Uuid
  deliveryFee  BigInt?  @map("delivery_fee") // null = restaurant confirms; 0 = free
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  area         Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  orderIntents OrderIntent[]

  @@unique([restaurantId, areaId])
  @@index([areaId, isActive])
  @@map("restaurant_delivery_areas")
}

model RestaurantHours {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt // 0 = Sunday .. 6 = Saturday
  openTime     DateTime @map("open_time") @db.Time(0)
  closeTime    DateTime @map("close_time") @db.Time(0) // earlier than open = closes after midnight
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, dayOfWeek, openTime])
  @@map("restaurant_hours")
}

model MenuCategory {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      MenuItem[]

  @@unique([id, restaurantId]) // target of the composite FK from menu_items
  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  basePrice    BigInt?  @map("base_price") // null when variants are used
  isAvailable  Boolean  @default(true) @map("is_available")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category    MenuCategory      @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  variants    MenuItemVariant[]
  intentItems OrderIntentItem[]

  @@unique([id, restaurantId]) // target of composite FKs from variants and order_intent_items
  @@index([restaurantId, categoryId, sortOrder])
  @@map("menu_items")
}

model MenuItemVariant {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  name         String
  price        BigInt
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  menuItem    MenuItem          @relation(fields: [menuItemId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  intentItems OrderIntentItem[]

  @@unique([id, restaurantId, menuItemId]) // target of the composite FK from order_intent_items
  @@index([menuItemId])
  @@map("menu_item_variants")
}

model OrderIntent {
  id                         String            @id @default(uuid(7)) @db.Uuid
  publicRef                  String            @unique @map("public_ref")
  clientRequestId            String            @unique @map("client_request_id") @db.Uuid
  restaurantId               String            @map("restaurant_id") @db.Uuid
  status                     OrderIntentStatus @default(WHATSAPP_HANDOFF_READY)
  restaurantNameSnapshot     String            @map("restaurant_name_snapshot")
  restaurantWhatsappSnapshot String            @map("restaurant_whatsapp_snapshot")
  customerName               String?           @map("customer_name") // optional

  customerPhone              String?           @map("customer_phone") // optional

  deliveryAreaId             String            @map("delivery_area_id") @db.Uuid
  deliveryAreaNameSnapshot   String            @map("delivery_area_name_snapshot")
  landmark                   String
  directions                 String?
  mapLat                     Decimal?          @map("map_lat") @db.Decimal(9, 6)
  mapLng                     Decimal?          @map("map_lng") @db.Decimal(9, 6)
  subtotal                   BigInt
  deliveryFee                BigInt?           @map("delivery_fee")
  deliveryFeeStatus          DeliveryFeeStatus @map("delivery_fee_status")
  currency                   String            @default("PKR")
  whatsappOpenedAt           DateTime?         @map("whatsapp_opened_at") @db.Timestamptz(3)
  expiresAt                  DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  // Composite FK: the area must be one this SAME restaurant serves.
  deliveryArea RestaurantDeliveryArea @relation(fields: [restaurantId, deliveryAreaId], references: [restaurantId, areaId], onDelete: Restrict)
  items        OrderIntentItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([restaurantId, customerPhone, createdAt]) // per-phone rate limit, only used when a phone was supplied
  @@map("order_intents")
}

model OrderIntentItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  orderIntentId       String  @map("order_intent_id") @db.Uuid
  restaurantId        String  @map("restaurant_id") @db.Uuid
  menuItemId          String  @map("menu_item_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  itemNameSnapshot    String  @map("item_name_snapshot")
  variantNameSnapshot String? @map("variant_name_snapshot")
  unitPrice           BigInt  @map("unit_price")
  quantity            Int
  lineTotal           BigInt  @map("line_total")
  lineNo              Int     @map("line_no")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderIntent OrderIntent      @relation(fields: [orderIntentId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  menuItem    MenuItem         @relation(fields: [menuItemId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  variant     MenuItemVariant? @relation(fields: [variantId, restaurantId, menuItemId], references: [id, restaurantId, menuItemId], onDelete: Restrict)

  @@unique([orderIntentId, lineNo])
  @@index([menuItemId])
  @@map("order_intent_items")
}

model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  restaurantId String?  @map("restaurant_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
